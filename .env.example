# Bind to loopback by default. Use a reverse proxy with TLS for remote access.
HOST=127.0.0.1
PORT=3000
NODE_ENV=production
TRUST_PROXY=false

# Create a strong password before first start. The application refuses weak defaults.
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD_AT_LEAST_16_CHARACTERS

# Explicit IPv4 targets only. Comma-separated IPs/CIDRs.
# Example for an isolated home lab: 192.168.1.0/24,10.10.20.15
AUTHORIZED_CIDRS=192.168.1.0/24

# Resource limits
MAX_TARGETS=256
MAX_CONCURRENCY=8
MAX_PORTS=32
CONNECT_TIMEOUT_MS=1200
BANNER_TIMEOUT_MS=700
JOB_RETENTION_DAYS=30
LOG_LEVEL=info
